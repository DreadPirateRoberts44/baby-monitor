# Local runtime state -- per-device data, not something to commit.
pi/care_events.sqlite      # caregiver-logged feed/change events (care_events.py)
pi/cry_history.sqlite      # completed crying sessions (cry_history.py)
pi/device_events.sqlite    # monitor startup/shutdown history (device_events.py)
pi/prediction_state.sqlite # app-controlled pause/resume flag (prediction_state.py)

